generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==== 基础枚举（用字符串枚举语义） ====
// SQLite 不支持枚举，使用 String 类型
// RecurrenceLike: "MONTHLY" | "QUARTERLY" | "YEARLY"
// AccountType: "SAVINGS" | "INVESTMENT" | "LOAN"
// AccountStatus: "ACTIVE" | "ARCHIVED"
// EntryTypeLike: "DEPOSIT" | "WITHDRAW" | "TRANSFER" | "ADJUST" | "SYSTEM"

// ==== 用户 ====
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String?
  displayCurrency String?
  currentCityId String
  currentCity   City     @relation(fields: [currentCityId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  incomes       IncomeRecord[]
  incomeChanges IncomeChange[]
  bonusPlans    BonusPlan[]
  ltcPlans      LongTermCashPlan[]
  accounts      Account[]
  txnEntries    TxnEntry[]
  auditLogs     AuditLog[]
  equityGrants  EquityGrant[]
  cityChanges   CityChangeRecord[]
  annualDeductions UserAnnualDeduction[]
  recalcTasks      IncomeRecalcTask[]
  reportDatasets  ReportDataset[]

  @@index([email])
  @@index([isActive])
  @@index([currentCityId])
}

// ==== 城市 & 规则 ====
model City {
  id        String   @id @default(uuid())
  name      String   @unique
  country   String   @default("CN")
  createdAt DateTime @default(now())

  ssRules       CityRuleSS[]
  hfRules       CityRuleHF[]
  users         User[]
  incomeRecords IncomeRecord[]
  cityChangesTo   CityChangeRecord[] @relation("CityChangeToCity")
  cityChangesFrom CityChangeRecord[] @relation("CityChangeFromCity")
  recalcTasks     IncomeRecalcTask[]
}

model CityRuleSS {
  id                   String    @id @default(uuid())
  cityId               String
  effectiveFrom        DateTime  @map("startDate")
  effectiveTo          DateTime? @map("endDate")
  currency             String    @default("CNY")
  baseMin              Decimal
  baseMax              Decimal
  ratePension          Decimal // 个人
  rateMedical          Decimal // 个人
  rateUnemployment     Decimal // 个人
  fixedMedicalPersonal Decimal? // 固定医疗费用（个人）

  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id])

  @@unique([cityId, effectiveFrom], map: "CityRuleSS_cityId_startDate_key")
  @@index([cityId, effectiveFrom], map: "CityRuleSS_cityId_startDate_idx")
}

model CityRuleHF {
  id           String    @id @default(uuid())
  cityId       String
  effectiveFrom DateTime  @map("startDate")
  effectiveTo   DateTime? @map("endDate")
  currency      String    @default("CNY")
  baseMin      Decimal
  baseMax      Decimal
  rateEmployee Decimal // 个人比例
  createdAt    DateTime  @default(now())

  city City @relation(fields: [cityId], references: [id])

  @@unique([cityId, effectiveFrom], map: "CityRuleHF_cityId_startDate_key")
  @@index([cityId, effectiveFrom], map: "CityRuleHF_cityId_startDate_idx")
}

// ==== 税制（国家 + 税年） ====
model TaxConfig {
  id                         String   @id @default(uuid())
  country                    String
  taxYear                    Int
  currency                   String   @default("CNY")
  effectiveFrom              DateTime @default(now())
  effectiveTo                DateTime?
  standardDeduction          Decimal // 月度起征额（例：5000）
  specialAdditionalDeduction Decimal? // 专项附加扣除（按月），默认 0

  createdAt DateTime     @default(now())
  brackets  TaxBracket[]

  @@unique([country, taxYear])
}

model TaxBracket {
  id             String  @id @default(uuid())
  country        String
  taxYear        Int
  currency       String  @default("CNY")
  effectiveFrom  DateTime @default(now())
  effectiveTo    DateTime?
  position       Int
  threshold      Decimal // 年度累计应纳税所得额阈值上限（含）
  taxRate        Decimal
  quickDeduction Decimal

  config TaxConfig @relation(fields: [country, taxYear], references: [country, taxYear], onDelete: Cascade, onUpdate: Cascade)

  @@unique([country, taxYear, position])
}

// ==== 账户与账务 ====
model Account {
  id             String   @id @default(uuid())
  userId         String
  name           String
  accountType    String // AccountType: "SAVINGS" | "INVESTMENT" | "LOAN" | "OTHER"
  baseCurrency   String
  initialBalance Decimal  @default(0)
  subType        String?
  description    String?
  status         String   @default("ACTIVE") // AccountStatus: "ACTIVE" | "ARCHIVED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  txnLines           TxnLine[]
  counterpartyLines  TxnLine[]          @relation("TxnLineCounterparty")
  valuations         ValuationSnapshot[]

  @@index([userId])
}

model FxRate {
  id             String   @id @default(uuid())
  base           String
  quote          String
  rate           Decimal
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries       TxnEntry[]
  valuations    ValuationSnapshot[]
  incomeRecords IncomeRecord[]
  snapshots     FxSnapshot[]

  @@index([base, quote, effectiveFrom])
  @@index([base, quote, effectiveTo])
  @@unique([base, quote, effectiveFrom])
}

model FxSnapshot {
  id             String   @id @default(uuid())
  baseCurrency   String
  quoteCurrency  String
  rate           Decimal
  capturedAt     DateTime
  sourceRateId   String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime @default(now())
  createdBy      String?

  sourceRate        FxRate?             @relation(fields: [sourceRateId], references: [id], onDelete: SetNull)
  txnEntries        TxnEntry[]
  txnLines          TxnLine[]
  valuationSnapshots ValuationSnapshot[]
  incomeRecords     IncomeRecord[]

  @@index([baseCurrency, quoteCurrency, capturedAt])
  @@index([sourceRateId])
  @@unique([baseCurrency, quoteCurrency, sourceRateId, capturedAt])
}

model TxnEntry {
  id         String   @id @default(uuid())
  userId     String
  type       String // EntryTypeLike: "DEPOSIT" | "WITHDRAW" | "TRANSFER" | "ADJUST" | "SYSTEM"
  occurredAt DateTime
  fxRateId   String?
  fxSnapshotId String?
  fxAppliedRate Decimal @default(1)
  note       String?
  meta       String? // JSON serialized string
  createdAt  DateTime @default(now())

  user   User      @relation(fields: [userId], references: [id])
  fxRate FxRate?   @relation(fields: [fxRateId], references: [id])
  fxSnapshot FxSnapshot? @relation(fields: [fxSnapshotId], references: [id], onDelete: SetNull)
  lines  TxnLine[]

  @@index([userId, occurredAt])
  @@index([fxSnapshotId])
}

model TxnLine {
  id                    String   @id @default(uuid())
  entryId               String
  accountId             String
  type                  String
  amount                Decimal
  currency              String
  counterpartyAccountId String?
  counterpartyName      String?
  exchangeRateAB        Decimal?
  viaCurrency           String?  @default("USD")
  rateAtoUSD            Decimal?
  rateUSDtoB            Decimal?
  fxSnapshotId          String?
  fxAppliedRate         Decimal @default(1)
  fxEffectiveAt         DateTime?
  principalDelta        Decimal  @default(0)
  valuationDelta        Decimal  @default(0)
  attachmentUrl         String?
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entry               TxnEntry @relation(fields: [entryId], references: [id])
  account             Account  @relation(fields: [accountId], references: [id])
  counterpartyAccount Account? @relation("TxnLineCounterparty", fields: [counterpartyAccountId], references: [id])
  fxSnapshot          FxSnapshot? @relation(fields: [fxSnapshotId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([entryId, type])
  @@index([counterpartyAccountId])
  @@index([fxSnapshotId])
}

model ValuationSnapshot {
  id         String   @id @default(uuid())
  accountId  String
  asOf       DateTime
  totalValue Decimal
  currency   String
  fxRateId   String?
  fxSnapshotId String?
  fxAppliedRate Decimal @default(1)
  note       String?
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  fxRate  FxRate? @relation(fields: [fxRateId], references: [id])
  fxSnapshot FxSnapshot? @relation(fields: [fxSnapshotId], references: [id], onDelete: SetNull)

  @@unique([accountId, asOf])
  @@index([fxSnapshotId])
}

model UserAnnualDeduction {
  id             String   @id @default(uuid())
  userId         String
  taxYear        Int
  annualAmount   Decimal  @default(0)
  allocationRule String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taxYear])
  @@index([userId, taxYear])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  meta      String? // JSON serialized string
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ==== 收入（工资变更/奖金/长期现金/月度记录） ====
model IncomeChange {
  id            String   @id @default(uuid())
  userId        String
  grossMonthly  Decimal
  currency      String   @default("CNY")
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, effectiveFrom])
}

model BonusPlan {
  id            String   @id @default(uuid())
  userId        String
  amount        Decimal
  currency      String   @default("CNY")
  taxMethod     String   @default("MERGE") // MERGE: 并入工资综合计税; SEPARATE: 单独计税
  effectiveDate DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, effectiveDate])
}

model LongTermCashPlan {
  id          String   @id @default(uuid())
  userId      String
  totalAmount Decimal
  currency    String   @default("CNY")
  startDate   DateTime // 授予起始（第一期）
  periods     Int // 每年4期：示例=4
  recurrence  String // RecurrenceLike: "QUARTERLY"
  createdAt   DateTime @default(now())

  user    User                 @relation(fields: [userId], references: [id])
  payouts LongTermCashPayout[]

  @@index([userId, startDate])
}

model LongTermCashPayout {
  id        String   @id @default(uuid())
  planId    String
  payDate   DateTime
  amount    Decimal
  currency  String   @default("CNY") // 生成时写入 plan.currency，避免计划币种变更影响已生成记录
  createdAt DateTime @default(now())

  plan LongTermCashPlan @relation(fields: [planId], references: [id])

  @@unique([planId, payDate], map: "planId_payDate")
}

model IncomeRecord {
  id             String   @id @default(uuid())
  userId         String
  monthDate      DateTime // 当月第一天
  cityId         String?
  currency       String   @default("CNY")
  sourceCurrency String? // 原始币种
  fxRateId       String? // 汇率快照ID
  fxSnapshotId   String?
  fxAppliedRate  Decimal @default(1)

  // 来自工资/奖金/长期现金/股权激励的“毛收入”组成
  gross        Decimal // 月薪（从 IncomeChange 推）
  bonus        Decimal? @default(0) // 一次性奖金（同月累加）
  ltcIncome    Decimal? @default(0) // 长期现金
  equityIncome Decimal? @default(0) // 股权激励

  // 基数可覆盖
  socialInsuranceBase Decimal?
  housingFundBase     Decimal?

  // 计算快照
  socialInsurance   Decimal? @default(0)
  housingFund       Decimal? @default(0)
  specialDeductions Decimal? @default(0)
  otherDeductions   Decimal? @default(0)
  charityDonations  Decimal? @default(0)

  // 人工覆盖
  manualGross     Decimal?
  manualTaxable   Decimal?
  manualIncomeTax Decimal?
  manualNet       Decimal?
  manualNote      String?

  // 对账字段
  taxableCurrent     Decimal?
  incomeTax          Decimal?
  taxPaidCumulative  Decimal? @default(0) // 累计已缴
  taxableCumulative  Decimal?
  taxCumulative      Decimal?
  netIncome          Decimal?
  source             String   @default("system")
  isForecast         Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  city       City?       @relation(fields: [cityId], references: [id])
  fxRate     FxRate?     @relation(fields: [fxRateId], references: [id])
  fxSnapshot FxSnapshot? @relation(fields: [fxSnapshotId], references: [id], onDelete: SetNull)

  @@unique([userId, monthDate])
  @@index([userId, monthDate])
  @@index([fxSnapshotId])
}

model IncomeRecalcTask {
  id           String   @id @default(uuid())
  userId       String?
  taxYear      Int
  startMonth   Int      @default(1)
  endMonth     Int      @default(12)
  cityId       String?
  status       String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  scheduledFor DateTime @default(now())
  attempts     Int      @default(0)
  lastError    String?
  triggeredBy  String? // 触发来源：userId/adminId/系统
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  processedAt  DateTime?

  user User? @relation(fields: [userId], references: [id])
  city City? @relation(fields: [cityId], references: [id])

  @@index([status, scheduledFor])
  @@index([userId, taxYear, status])
}

model EventOutbox {
  id          String   @id @default(uuid())
  eventType   String
  payload     Json
  status      String   @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts    Int      @default(0)
  lastError   String?
  occurredAt  DateTime @default(now())
  availableAt DateTime @default(now())
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, availableAt])
  @@index([eventType, status])
}

model ReportDataset {
  id        String   @id @default(uuid())
  userId    String
  scope     String
  bucket    String   @default("default")
  payload   Json
  occurredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, bucket])
  @@index([scope, bucket])
  @@index([userId, scope])
}

// ==== 股权激励（授予与归属） ====
model EquityGrant {
  id            String   @id @default(uuid())
  userId        String
  totalUnits    Decimal
  currency      String   @default("CNY")
  startVestDate DateTime
  vestPeriods   Int
  vestInterval  String // RecurrenceLike: "YEARLY" | "QUARTERLY"
  createdAt     DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id])
  vests EquityVest[]

  @@index([userId, startVestDate])
}

model EquityVest {
  id        String   @id @default(uuid())
  grantId   String
  vestDate  DateTime
  units     Decimal
  fairValue Decimal?
  currency  String
  createdAt DateTime @default(now())

  grant EquityGrant @relation(fields: [grantId], references: [id])

  @@unique([grantId, vestDate], map: "grantId_vestDate")
}

// ==== 幂等键（写操作请求指纹） ====
model IdempotencyKey {
  key       String    @id
  userId    String?
  hash      String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime?

  @@index([userId, createdAt])
}

// ==== 城市变更记录 ====
model CityChangeRecord {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCityId     String?
  fromCity       City?    @relation("CityChangeFromCity", fields: [fromCityId], references: [id])
  toCityId       String
  toCity         City     @relation("CityChangeToCity", fields: [toCityId], references: [id])
  effectiveMonth DateTime
  reason         String?
  createdAt      DateTime @default(now())

  @@index([userId, effectiveMonth])
  @@index([toCityId])
  @@index([fromCityId])
}
